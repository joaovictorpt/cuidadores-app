generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  birthDate     DateTime?
  role          Role      @default(FAMILY)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  familyProfile    FamilyProfile?
  caregiverProfile CaregiverProfile?

  reviewsWritten  Review[] @relation("ReviewAuthor")
  reviewsReceived Review[] @relation("ReviewTarget")

  hiresAsFamily    Hire[] @relation("HireFamily")
  hiresAsCaregiver Hire[] @relation("HireCaregiver")
}

enum Role {
  FAMILY
  CAREGIVER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FamilyProfile {
  id               String     @id @default(cuid())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone            String?
  city             String?
  state            String?
  address          String?
  bio              String?
  hourlyBudget     Decimal?   @db.Decimal(10, 2)
  latitude         Float?
  longitude        Float?
  neededCareTypes  CareType[]

  // Whether this family shows up when a caregiver browses/searches families
  // or gets matched via Gale-Shapley (see lib/matching.ts findCandidateFamilies).
  // Never affects this family's own search for caregivers -- visibility is
  // one-directional, per side.
  visibleToCaregivers Boolean @default(true)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model CaregiverProfile {
  id              String     @id @default(cuid())
  userId          String     @unique
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  phone           String?
  city            String?
  state           String?
  bio             String?
  hourlyRate      Decimal?   @db.Decimal(10, 2)
  experienceYears Int?
  careTypes       CareType[]
  verified        Boolean    @default(false)
  latitude        Float?
  longitude       Float?

  // Whether this caregiver shows up when a family browses/searches
  // caregivers or gets matched via Gale-Shapley (see lib/matching.ts
  // findCandidateCaregivers). Never affects this caregiver's own search for
  // families -- visibility is one-directional, per side.
  visibleToFamilies  Boolean               @default(true)
  // Purely informational -- shown as a badge wherever a caregiver is
  // displayed to a family, never used to filter or reorder search/matching
  // results (see lib/matching.ts).
  availabilityStatus CaregiverAvailability @default(AVAILABLE)

  documents       Document[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

enum CareType {
  ELDERLY
  CHILD
  SPECIAL_NEEDS
}

enum CaregiverAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

model Document {
  id          String             @id @default(cuid())
  caregiverId String
  caregiver   CaregiverProfile   @relation(fields: [caregiverId], references: [id], onDelete: Cascade)

  type        DocumentType
  fileUrl     String
  status      VerificationStatus @default(PENDING)

  uploadedAt  DateTime           @default(now())
  reviewedAt  DateTime?
}

enum DocumentType {
  ID_DOCUMENT
  BACKGROUND_CHECK
  CERTIFICATE
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Hire {
  id          String     @id @default(cuid())

  familyId    String
  family      User       @relation("HireFamily", fields: [familyId], references: [id])

  caregiverId String
  caregiver   User       @relation("HireCaregiver", fields: [caregiverId], references: [id])

  status      HireStatus @default(PENDING)
  // Who reached out first -- determines which side is "proposing" (can
  // withdraw a still-PENDING request) vs "responding" (can accept/reject
  // it). See lib/hire-transitions.ts. Defaults to FAMILY so every Hire row
  // created before this field existed (only families could initiate then)
  // keeps its correct historical meaning without a data migration.
  initiatedBy HireInitiator @default(FAMILY)
  message     String?
  startDate   DateTime?
  endDate     DateTime?

  // Which specific need this Hire is for, chosen from the real overlap
  // between the two profiles' care types at creation time (see
  // POST /api/hires). Nullable, not backfilled -- Hires created before this
  // field existed simply show "Tipo não especificado" (see
  // /dashboard/hires/[id]), same non-retroactive pattern already used for
  // acceptedAt/completedAt above.
  careType    CareType?

  // Real timestamps of the two state-machine transitions that matter for
  // display (PENDING -> ACCEPTED, ACCEPTED -> COMPLETED), set by
  // PATCH /api/hires/[id] -- never backfillable, so rows created before
  // this field existed simply keep it null (see /dashboard/hires/[id],
  // which shows "Duração não disponível" instead of guessing).
  acceptedAt  DateTime?
  completedAt DateTime?

  // Set to "<familyId>:<caregiverId>" while status is PENDING or ACCEPTED,
  // and cleared back to null on any terminal transition (REJECTED,
  // COMPLETED, CANCELLED). Postgres unique indexes treat multiple NULLs as
  // non-conflicting, so this enforces "at most one active Hire per
  // family-caregiver pair" as a real DB constraint (not just an app-level
  // check) while still allowing a new Hire to be created later once the
  // previous one reaches a terminal state.
  activeHireKey String?  @unique

  review      Review?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

enum HireStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

enum HireInitiator {
  FAMILY
  CAREGIVER
}

model Review {
  id        String   @id @default(cuid())

  hireId    String   @unique
  hire      Hire     @relation(fields: [hireId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id])

  targetId  String
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id])

  rating    Int
  comment   String?

  createdAt DateTime @default(now())
}
